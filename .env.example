# Product-specific database URLs.
#
# Set all three tiers once, then switch targets with ENVIRONMENT (see README):
#   development -> DEV_DATABASE_URL_* (fallback: DATABASE_URL_*)
#   production  -> DATABASE_URL_*
#   test        -> TEST_DATABASE_URL_* (fallback: DATABASE_URL_*)
#
# Neon example (recommended):
# - Create two databases in the same Neon project/branch (e.g. `audit_tools_yee`, `audit_tools_playspace`)
# - Copy each connection string here, ensuring the database name matches the product DB
# - You can paste Neon’s standard `postgresql://...` URL directly (the app will normalize it for async SQLAlchemy)
#
# Local Postgres example:
# DEV_DATABASE_URL_YEE=postgresql+asyncpg://postgres:postgres@localhost:5432/audit_tools_yee
# DEV_DATABASE_URL_PLAYSPACE=postgresql+asyncpg://postgres:postgres@localhost:5432/audit_tools_playspace
# DATABASE_URL_YEE=postgresql+asyncpg://...
# DATABASE_URL_PLAYSPACE=postgresql+asyncpg://...
# TEST_DATABASE_URL_YEE=postgresql+asyncpg://...
# TEST_DATABASE_URL_PLAYSPACE=postgresql+asyncpg://...

# Default local tier when ENVIRONMENT is unset.
ENVIRONMENT=development

DATABASE_URL_YEE=
DATABASE_URL_PLAYSPACE=
DEV_DATABASE_URL_YEE=
DEV_DATABASE_URL_PLAYSPACE=
TEST_DATABASE_URL_YEE=
TEST_DATABASE_URL_PLAYSPACE=

# Legacy single-db configuration (optional)
# If you set DATABASE_URL (and leave DATABASE_URL_YEE empty), the app treats it as the YEE database.
# DATABASE_URL=

# Auth / session configuration
# Used for signed bearer tokens returned by /yee/auth/login and /playspace/auth/login
AUTH_TOKEN_SECRET_KEY=
AUTH_ACCESS_TOKEN_TTL_DAYS=7

# Optional email verification + anti-bot configuration
AUTH_EMAIL_VERIFY_TTL_HOURS=24
AUTH_PASSWORD_RESET_TTL_HOURS=2
TURNSTILE_SECRET_KEY=
AUTH_VERIFY_URL_TEMPLATE=
AUTH_PASSWORD_RESET_URL_TEMPLATE=
AUTH_INVITE_URL_TEMPLATE=
AUTH_MANAGER_INVITE_URL_TEMPLATE=

# Optional frontend/browser origins for deployed web apps.
# Comma-separated list. Example:
# CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app,https://app.yourdomain.com
CORS_ALLOWED_ORIGINS=

# Optional SMTP configuration for sending verification emails.
# If these are not set, verification links are logged to the backend console in local development.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

# Optional Brevo transactional email configuration.
# If BREVO_API_KEY is set, the backend will try Brevo before SMTP fallback.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Audit Tools
BREVO_REPLY_TO_EMAIL=

# Optional admin notification copy for outgoing emails.
ADMIN_NOTIFICATION_EMAIL=

# Optional rate limiting configuration for notifications endpoints.
RATELIMIT_ENABLED=true

# Optional protection list for seeded YEE demo users.
# When unset, the backend protects the built-in seeded YEE demo emails by default
# so invite acceptance and password-reset flows do not mutate shared review logins.
# PROTECTED_YEE_DEMO_EMAILS=manager-demo@yee.local,admin-demo@yee.local,auditor-demo-1@yee.local
